# Copy to examples/.env and fill in. Paths are on the server.

# The library: YYYY/YYYY-MM/YYYY-MM-DD folders, or an empty folder to start.
LIBRARY=/srv/photos/library
# New photos are dropped here and filed into the library by the day they were taken.
IMPORT=/srv/photos/import
# The catalogue and previews. Use a local disk, not a network share.
STATE=/srv/daddy-cull

# The user and group that own the three folders above.
PUID=1000
PGID=1000
TZ=Europe/London

# The address and port on this server Daddy Cull listens on, such as its LAN address.
LISTEN_IP=127.0.0.1
PORT=8830

# A private key the two containers share. Make one with: openssl rand -hex 32
CULL_BIN_KEY=

# Optional: Immich, if it reads the library as an external library.
IMMICH_URL=
IMMICH_KEY=
IMMICH_PATH_PREFIX=
