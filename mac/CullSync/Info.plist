<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>app.daddycull.sync</string>
	<key>CFBundleName</key>
	<string>Cull Sync</string>
	<key>CFBundleDisplayName</key>
	<string>Cull Sync</string>
	<key>CFBundleExecutable</key>
	<string>CullSync</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.2</string>
	<key>CFBundleVersion</key>
	<string>3</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Cull Sync finds the photographs you removed or favourited in Daddy Cull, shows them to you in the browser, and removes or favourites them in Photos only when you apply.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Daddy Cull is usually served over plain HTTP: on this Mac, on the LAN,
		     or on a tailnet, which WireGuard already encrypts. Local addresses are
		     allowed here; build.sh adds the one named server that is not local. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
